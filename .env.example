# ========================================================
# GOAT ESPORTS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local: cp .env.example .env.local
# DO NOT commit real secrets or production credentials to git!
# ========================================================

# 1. AUTHENTICATION SECRET (Required for session integrity)
# At least 32 random characters used to sign HMAC-SHA256 session tokens.
# Generate on macOS/Linux with: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-characters-random-secret

# 2. ORGANIZATION OWNER EMAIL
# Any user who signs in with this verified email automatically receives the OWNER role.
OWNER_EMAIL=adiebhadauria@gmail.com

# 3. GOOGLE OAUTH CREDENTIALS (Optional for Google Social Login)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# 4. DATABASE CONNECTION STRING (Optional managed PostgreSQL / Neon)
# If omitted, system seamlessly runs in in-memory session mode with mock data.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
